PORT=4310
POCKET_CONCIERGE_AGENT_KEYS=demo-agent:replace-with-a-long-random-secret
POCKET_CONCIERGE_DB_PATH=.data/concierge.sqlite

# NFT mint pilot remains off until every value below is configured.
POCKET_CONCIERGE_NFT_MINT_ENABLED=false
ETHEREUM_RPC_URL=
POCKET_CONCIERGE_NFT_TREASURY_ADDRESS=
POCKET_CONCIERGE_NFT_ORDER_TOKEN_SECRET=
POCKET_CONCIERGE_NFT_OPERATOR_KEY=
# Optional. When set, order creation requires X-Pocket-Pilot-Key before x402.
POCKET_CONCIERGE_NFT_PILOT_KEY=
POCKET_CONCIERGE_NFT_WORKER_MAX_FEE_PER_GAS_WEI=
# Isolated AWS KMS worker only. Keep these out of the public API service.
POCKET_CONCIERGE_NFT_SIGNER_DB_PATH=.data/nft-signer.sqlite
POCKET_CONCIERGE_NFT_KMS_KEY_ID=
AWS_REGION=
POCKET_CONCIERGE_NFT_MIN_CONFIRMATIONS=2
POCKET_CONCIERGE_NFT_PLAN_TTL_SECONDS=30
POCKET_CONCIERGE_NFT_DELIVERY_GAS_LIMIT=120000
POCKET_CONCIERGE_NFT_REFUND_GAS_LIMIT=21000
POCKET_CONCIERGE_NFT_MAX_ORDER_WEI=100000000000000000
# Optional. Publishes one completed privacy-safe pilot proof.
POCKET_CONCIERGE_NFT_DEMO_EXTERNAL_ID=
POCKET_CONCIERGE_NFT_DEMO_SERVICE_PAYMENT_TX=
