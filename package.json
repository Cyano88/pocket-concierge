{
  "name": "pocket-concierge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/src/server.js",
    "nft:preflight": "tsx scripts/nft-mainnet-preflight.ts",
    "nft:direct-smoke": "tsx scripts/nft-direct-smoke.ts",
    "nft:worker": "tsx scripts/nft-assisted-worker.ts",
    "nft:vps-keystore": "tsx scripts/nft-vps-keystore.ts",
    "nft:vps-worker": "tsx scripts/nft-vps-worker.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@okxweb3/x402-core": "^0.1.0",
    "@okxweb3/x402-evm": "^0.2.1",
    "ethers": "^6.17.0",
    "tsx": "^4.23.0",
    "viem": "^2.55.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.0"
  }
}
